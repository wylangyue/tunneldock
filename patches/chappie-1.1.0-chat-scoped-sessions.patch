--- /dev/null
+++ b/src/errors.ts
@@ -0,0 +1,57 @@
+export type ExecutionState = "not_started" | "completed" | "unknown";
+
+export class BridgeError extends Error {
+	readonly code: string;
+	readonly layer: "mcp" | "broker" | "pi";
+	readonly execution: ExecutionState;
+	readonly recovery: "none" | "resume_session" | "inspect_history";
+	readonly sessionId: string | undefined;
+	constructor(
+		code: string,
+		message: string,
+		layer: "mcp" | "broker" | "pi" = "broker",
+		execution: ExecutionState = "not_started",
+		recovery: "none" | "resume_session" | "inspect_history" = "none",
+		sessionId?: string,
+	) {
+		super(message);
+		this.code = code;
+		this.layer = layer;
+		this.execution = execution;
+		this.recovery = recovery;
+		this.sessionId = sessionId;
+	}
+}
+
+export function bridgeErrorResult(error: unknown, requestId?: unknown) {
+	const fault =
+		error instanceof BridgeError
+			? error
+			: new BridgeError(
+					"request_failed",
+					"The bridge request failed; inspect session history before retrying.",
+					"broker",
+					"unknown",
+					"inspect_history",
+				);
+	const details = {
+		code: fault.code,
+		message: fault.message,
+		layer: fault.layer,
+		execution: fault.execution,
+		retryable:
+			fault.execution === "not_started" && fault.recovery === "resume_session",
+		recovery: fault.recovery,
+		...(fault.sessionId ? { sessionId: fault.sessionId } : {}),
+		...(typeof requestId === "string" || typeof requestId === "number"
+			? { requestId }
+			: {}),
+	};
+	return {
+		isError: true,
+		content: [
+			{ type: "text" as const, text: JSON.stringify({ error: details }) },
+		],
+		structuredContent: { text: details.message, error: details },
+	};
+}
