#!/usr/bin/env bash
set -Eeuo pipefail

VERSION="0.3.0"
NODE_VERSION="${TUNNELDOCK_NODE_VERSION:-26.10.0}"
PI_VERSION="${TUNNELDOCK_PI_VERSION:-0.99.2}"
CHAPPIE_VERSION="${TUNNELDOCK_CHAPPIE_VERSION:-1.1.0}"
OTUNNEL_VERSION="${TUNNELDOCK_OTUNNEL_VERSION:-0.2.0}"

SCRIPT_DIR="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
ROOT_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"
PATCH_FILE="$ROOT_DIR/patches/chappie-${CHAPPIE_VERSION}-chat-scoped-sessions.patch"
PATCH_REVISION=3
CHAPPIE_BUILD_VERSION="$CHAPPIE_VERSION-tunneldock.$PATCH_REVISION"
PNPM_VERSION=12.4.1
CONFIG_HELPER="$ROOT_DIR/libexec/tunneldock-config.py"
CACHE_DIR="$HOME/.local/share/tunneldock"
CHAPPIE_ARCHIVE="$CACHE_DIR/zetaloop-chappie-${CHAPPIE_BUILD_VERSION}.tgz"
PROFILE_DIR="${TUNNEL_CLIENT_PROFILE_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/tunnel-client}"
PROFILE_DIR="$(realpath -m -- "$PROFILE_DIR")"
PROFILE_FILE="$PROFILE_DIR/chappie.yaml"
PI_AGENT_DIR="$(realpath -m -- "${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}")"
CHAPPIE_DIR="$HOME/.npm-global/lib/node_modules/@zetaloop/chappie"
CHAPPIE_CONFIG="$HOME/.chappie/config.json"
SERVICE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
SERVICE_FILE="$SERVICE_DIR/chappie-tunnel.service"
KEY_DIR="$HOME/.chappie"
KEY_FILE="$KEY_DIR/tunnelkey.txt"

export PATH="$HOME/.local/bin:$HOME/.npm-global/bin:$HOME/.cargo/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}"
export npm_config_prefix="$HOME/.npm-global"

log() { printf '[tunneldock] %s\n' "$*"; }
warn() { printf '[tunneldock] WARNING: %s\n' "$*" >&2; }
die() { printf '[tunneldock] ERROR: %s\n' "$*" >&2; exit 1; }

have() { command -v "$1" >/dev/null 2>&1; }

config_tool() { python3 "$CONFIG_HELPER" "$@"; }

pi_chappie_registered() {
	pi list | sed 's/^[[:space:]]*//' | grep -Fx "$CHAPPIE_DIR" >/dev/null
}

require_value() {
	[[ $# -ge 2 && -n "$2" && "$2" != --* ]] || die "参数 $1 需要一个值"
}

validate_versions() {
	local value
	for value in "$NODE_VERSION" "$PI_VERSION" "$CHAPPIE_VERSION" "$OTUNNEL_VERSION"; do
		[[ "$value" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "版本号必须为 MAJOR.MINOR.PATCH"
	done
	[[ "$CHAPPIE_VERSION" == "1.1.0" && -f "$PATCH_FILE" ]] || die "尚未验证 Chappie $CHAPPIE_VERSION 的会话补丁；请使用 1.1.0"
}

as_root() {
	if [[ "$(id -u)" -eq 0 ]]; then
		"$@"
	elif have sudo; then
		sudo "$@"
	else
		die "需要 root 权限执行: $*. 请安装 sudo 或使用 root 运行。"
	fi
}

require_linux() {
	[[ "$(uname -s)" == "Linux" ]] || die "CLI 版 TunnelDock 仅支持 Linux VPS。"
}

require_systemd_user() {
	have systemctl || die "找不到 systemctl；当前版本要求 systemd。"
	systemctl --user show-environment >/dev/null 2>&1 || die "systemd --user 不可用。请使用正常登录用户运行，而不是无 user bus 的临时 shell。"
}

install_prereqs() {
	require_linux
	if have apt-get; then
		log "安装/确认基础依赖..."
		as_root env DEBIAN_FRONTEND=noninteractive apt-get update -y
		as_root env DEBIAN_FRONTEND=noninteractive apt-get install -y \
			ca-certificates curl git patch python3 python3-yaml xz-utils tar coreutils
	else
		for cmd in curl git patch python3 xz tar sha256sum; do
			have "$cmd" || die "缺少 $cmd，且当前系统不是 apt 系发行版。请手动安装后重试。"
		done
	fi
	python3 -c 'import yaml' >/dev/null 2>&1 || die "缺少 Python PyYAML；请安装 python3-yaml"
}

node_major() {
	node -p 'Number(process.versions.node.split(".")[0])' 2>/dev/null || printf '0'
}

install_node() (
	if have node && [[ "$(node_major)" -ge 26 ]]; then
		log "Node 已满足要求: $(node --version)"
	else
		local arch node_arch base archive tmp target expected
		arch="$(uname -m)"
		case "$arch" in
			x86_64|amd64) node_arch="x64" ;;
			aarch64|arm64) node_arch="arm64" ;;
			*) die "暂不支持 Node 自动安装架构: $arch" ;;
		esac
		base="node-v${NODE_VERSION}-linux-${node_arch}"
		archive="${base}.tar.xz"
		tmp="$(mktemp -d)"
		trap 'rm -rf "$tmp"' EXIT
		log "安装 Node.js v$NODE_VERSION ($node_arch)..."
		curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/${archive}" -o "$tmp/$archive"
		curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt" -o "$tmp/SHASUMS256.txt"
		expected="$(awk -v f="$archive" '$2==f {print $1}' "$tmp/SHASUMS256.txt")"
		[[ -n "$expected" ]] || die "未在 Node SHASUMS256.txt 中找到 $archive"
		printf '%s  %s\n' "$expected" "$tmp/$archive" | sha256sum -c -
		mkdir -p "$HOME/.local/opt" "$HOME/.local/bin"
		target="$HOME/.local/opt/$base"
		rm -rf "$target"
		tar -xJf "$tmp/$archive" -C "$HOME/.local/opt"
		ln -sfn "../opt/$base/bin/node" "$HOME/.local/bin/node"
		ln -sfn "../opt/$base/bin/npm" "$HOME/.local/bin/npm"
		ln -sfn "../opt/$base/bin/npx" "$HOME/.local/bin/npx"
		[[ -e "$HOME/.local/opt/$base/bin/corepack" ]] && ln -sfn "../opt/$base/bin/corepack" "$HOME/.local/bin/corepack"
		trap - EXIT
		rm -rf "$tmp"
	fi

	mkdir -p "$HOME/.npm-global"
	npm config set prefix "$HOME/.npm-global"
	log "Node: $(node --version), npm: $(npm --version), prefix: $(npm config get prefix)"
)

install_pi() {
	log "安装/更新 Pi coding agent @$PI_VERSION..."
	npm_config_min_release_age=0 npm install -g --ignore-scripts --no-audit --no-fund "@earendil-works/pi-coding-agent@$PI_VERSION"
	have pi || die "Pi 安装结束但 PATH 中找不到 pi"
	log "Pi: $(pi --version)"
}

ensure_rust_for_otunnel() {
	log "准备 otunnel 本机编译工具链..."
	if have apt-get; then
		as_root env DEBIAN_FRONTEND=noninteractive apt-get install -y build-essential pkg-config cmake
	else
		for cmd in cc make cmake pkg-config; do
			have "$cmd" || die "源码编译缺少 $cmd，请安装后重试"
		done
	fi
	if ! have rustup; then
		local rustup_script
		rustup_script="$(mktemp)"
		if ! curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs -o "$rustup_script"; then
			rm -f "$rustup_script"
			die "无法下载 rustup"
		fi
		sh "$rustup_script" -y --profile minimal --default-toolchain stable
		rm -f "$rustup_script"
	fi
	rustup toolchain install stable --profile minimal
}

install_otunnel_from_source() {
	ensure_rust_for_otunnel
	log "在当前 VPS 本机编译 otunnel v$OTUNNEL_VERSION，以兼容本机 GLIBC..."
	cargo +stable install \
		--git https://github.com/zetaloop/otunnel.git \
		--tag "v$OTUNNEL_VERSION" \
		--locked \
		--force \
		--root "$HOME/.local" \
		otunnel
	"$HOME/.local/bin/otunnel" --version | grep -Fxq "otunnel $OTUNNEL_VERSION" ||
		die "otunnel 源码编译完成但运行验证失败"
	log "otunnel 源码编译安装成功: $("$HOME/.local/bin/otunnel" --version)"
}

install_otunnel() (
	mkdir -p "$HOME/.local/bin"
	if [[ "${TUNNELDOCK_FORCE_OTUNNEL_SOURCE:-0}" == "1" ]]; then
		install_otunnel_from_source
		return
	fi
	if have otunnel && otunnel --version 2>/dev/null | grep -Fxq "otunnel $OTUNNEL_VERSION"; then
		log "otunnel 已满足要求: $(otunnel --version)"
		return
	fi
	local arch target asset url tmp
	arch="$(uname -m)"
	case "$arch" in
		x86_64|amd64) target="x86_64-unknown-linux-gnu" ;;
		aarch64|arm64) target="aarch64-unknown-linux-gnu" ;;
		*) die "暂不支持 otunnel 自动安装架构: $arch" ;;
	esac
	asset="otunnel-${target}-v${OTUNNEL_VERSION}.tar.gz"
	url="https://github.com/zetaloop/otunnel/releases/download/v${OTUNNEL_VERSION}/${asset}"
	tmp="$(mktemp -d)"
	trap 'rm -rf "$tmp"' EXIT
	log "尝试安装 otunnel v$OTUNNEL_VERSION 官方预编译包 ($target)..."
	if curl -fL --retry 3 "$url" -o "$tmp/$asset" &&
	   tar -xzf "$tmp/$asset" -C "$tmp" otunnel &&
	   "$tmp/otunnel" --version 2>/dev/null | grep -Fxq "otunnel $OTUNNEL_VERSION"; then
		install -m 0755 "$tmp/otunnel" "$HOME/.local/bin/otunnel"
		log "otunnel 预编译包运行验证通过。"
		return
	fi
	warn "otunnel 预编译包下载、解压或运行验证失败；切换为本机源码编译。"
	install_otunnel_from_source
)

build_chappie() (
	local tmp
	tmp="$(mktemp -d)"
	trap 'rm -rf "$tmp"' EXIT
	log "从 Chappie v$CHAPPIE_VERSION 构建会话隔离版本..."
	git clone --quiet --depth 1 --branch "v$CHAPPIE_VERSION" https://github.com/zetaloop/chappie.git "$tmp/source"
	(
		cd "$tmp/source"
		node -e 'if (JSON.parse(require("fs").readFileSync("package.json")).version !== process.argv[1]) process.exit(1)' "$CHAPPIE_VERSION"
		patch --dry-run --batch --fuzz=0 -p1 < "$PATCH_FILE"
		patch --batch --fuzz=0 -p1 < "$PATCH_FILE"
	)
	# Build the published bundle; npm releases no longer contain src/*.ts.
	npm_config_min_release_age=0 npm install --prefix "$tmp/tools" --ignore-scripts --no-audit --no-fund "pnpm@$PNPM_VERSION"
	(
		cd "$tmp/source"
		"$tmp/tools/node_modules/.bin/pnpm" install --frozen-lockfile --ignore-scripts --config.minimum-release-age=0
		node_modules/.bin/tsc --noEmit
		node --input-type=commonjs - "$CHAPPIE_BUILD_VERSION" <<'JS'
const fs = require("node:fs");
const pkg = JSON.parse(fs.readFileSync("package.json"));
pkg.version = process.argv[2];
pkg.tunneldock = { chatScopedSessions: 1, runtimeHandshake: 1, runtimeDiagnostics: 1, ipcCapacity: 1 };
fs.writeFileSync("package.json", JSON.stringify(pkg, null, 2) + "\n");
JS
		# cli.js embeds package metadata, so rebuild with the local version.
		node scripts/build.ts
		npm pack --ignore-scripts --pack-destination "$tmp" >/dev/null
	)
	mkdir -p "$CACHE_DIR"
	install -m 0600 "$tmp/zetaloop-chappie-${CHAPPIE_BUILD_VERSION}.tgz" "$CHAPPIE_ARCHIVE"
)

install_chappie() {
	build_chappie
	log "安装 Chappie broker 和 Pi 扩展 @$CHAPPIE_BUILD_VERSION..."
	npm install -g --ignore-scripts --omit=peer --no-audit --no-fund "$CHAPPIE_ARCHIVE"
	# Remove only Chappie registrations; retain all other Pi extensions.
	local spec
	while IFS= read -r spec; do
		[[ -n "$spec" ]] && pi remove "$spec"
	done < <(pi list 2>/dev/null | sed -n 's/^[[:space:]]*\(npm:@zetaloop\/chappie[^[:space:]]*\).*/\1/p')
	pi install "$CHAPPIE_DIR"
	[[ "$(chappie --version)" == "$CHAPPIE_BUILD_VERSION" ]] || die "Chappie broker 运行验证失败"
	pi_chappie_registered || die "Pi 未注册 Chappie 扩展"
	pi --help >/dev/null || die "Pi 扩展加载失败"
}

write_session_config() {
	config_tool sessions-config "$CHAPPIE_CONFIG" "${1:-}" "${2:-}" "${3:-}"
	log "会话策略已写入 $CHAPPIE_CONFIG"
}

migrate_chappie() {
	config_tool migrate "$KEY_DIR" "$PI_AGENT_DIR"
	config_tool sessions-default "$CHAPPIE_CONFIG" "${TUNNELDOCK_SESSION_CWD:-$HOME}" "${TUNNELDOCK_SESSION_PREFIX:-chatgpt}" "${TUNNELDOCK_SESSION_IDLE_MINUTES:-30}"
	config_tool profile-broker "$PROFILE_FILE"
}

install_service() {
	require_systemd_user
	mkdir -p "$SERVICE_DIR"
	# Escape systemd specifiers and quotes without interpreting shell metacharacters.
	python3 - "$ROOT_DIR/systemd/chappie-tunnel.service.example" "$SERVICE_FILE" "$(command -v otunnel)" "$HOME" "$PI_AGENT_DIR" "$PROFILE_DIR" <<'PYUNIT'
from pathlib import Path
import sys
source, target, binary, home, agent, profiles = sys.argv[1:]
def quote(value):
    if any(c in value for c in "\n\r\0"):
        raise SystemExit("systemd path contains an unsupported control character")
    return '"' + value.replace('\\', '\\\\').replace('"', '\\"').replace('%', '%%') + '"'
path = f"{home}/.local/bin:{home}/.npm-global/bin:{home}/.cargo/bin:/usr/local/bin:/usr/bin:/bin"
unit = Path(source).read_text()
unit = unit.replace('Environment=PATH=%h/.local/bin:%h/.npm-global/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin', 'Environment=' + quote('PATH=' + path))
unit = unit.replace('ExecStart=%h/.local/bin/otunnel run --profile chappie', 'ExecStart=:' + quote(binary) + ' run --profile chappie --profile-dir ' + quote(profiles))
unit = unit.replace('UMask=0077', 'UMask=0077\nEnvironment=' + quote('PI_CODING_AGENT_DIR=' + agent))
Path(target).write_text(unit)
PYUNIT
	systemctl --user daemon-reload
	systemctl --user enable chappie-tunnel.service >/dev/null
	log "已安装 user service: $SERVICE_FILE"
	local username
	username="$(id -un)"
	if have loginctl; then
		if [[ "$(id -u)" -eq 0 ]]; then
			loginctl enable-linger "$username" 2>/dev/null || warn "无法启用 linger。"
		elif have sudo && sudo -n true >/dev/null 2>&1; then
			sudo loginctl enable-linger "$username" || warn "无法启用 linger。"
		else
			warn "未自动启用 linger。建议执行: sudo loginctl enable-linger $username"
		fi
	fi
}

install_all() (
	validate_versions
	require_linux
	require_systemd_user
	install_prereqs
	local was_active=0
	if systemctl --user is-active --quiet chappie-tunnel.service; then
		was_active=1
		systemctl --user stop chappie-tunnel.service
	fi
	trap 'if [[ "$was_active" == 1 ]]; then systemctl --user start chappie-tunnel.service || warn "服务恢复失败，请运行 tunneldock doctor"; fi' EXIT
	install_node
	install_pi
	install_otunnel
	install_chappie
	migrate_chappie
	install_service
	mkdir -p "$HOME/.local/bin"
	ln -sfn "$ROOT_DIR/bin/tunneldock" "$HOME/.local/bin/tunneldock"
	ln -sfn "$ROOT_DIR/bin/configure-chappie-tunnel" "$HOME/.local/bin/configure-chappie-tunnel"
	log "安装/更新完成。配置入口: configure-chappie-tunnel；诊断: tunneldock doctor"
)

configure_tunnel() {
	local tunnel_id="" api_key="" api_key_file="$KEY_FILE" health_addr="127.0.0.1:18080"
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--tunnel-id) require_value "$@"; tunnel_id="$2"; shift 2 ;;
			--api-key) require_value "$@"; api_key="$2"; shift 2 ;;
			--api-key-file) require_value "$@"; api_key_file="$2"; shift 2 ;;
			--health-addr) require_value "$@"; health_addr="$2"; shift 2 ;;
			-h|--help)
				cat <<'EOF'
Usage: configure-chappie-tunnel [options]
       tunneldock configure [options]
  --tunnel-id ID           OpenAI Tunnel ID
  --api-key KEY            Restricted API key (不推荐写进 shell history)
  --api-key-file PATH      Existing/new key file (default ~/.chappie/tunnelkey.txt)
  --health-addr ADDR       Health listen addr (default 127.0.0.1:18080)
EOF
				return
				;;
			*) die "未知 configure 参数: $1" ;;
		esac
	done

	validate_versions
	require_systemd_user
	health_addr="$(config_tool health-address "$health_addr")"
	api_key_file="$(python3 -c 'from pathlib import Path; import sys; print(Path(sys.argv[1]).expanduser().absolute())' "$api_key_file")"
	if ! have pi || ! have chappie; then die "请先运行 tunneldock install"; fi

	# Self-heal an absent or unusable otunnel before touching credentials/profile.
	# This specifically covers older VPSes where the release binary exists on disk
	# but cannot start because it requires a newer GLIBC.
	if ! have otunnel; then
		warn "未找到 otunnel；自动执行安装。"
		install_otunnel
	elif ! otunnel --version >/dev/null 2>&1; then
		warn "检测到 otunnel 文件，但当前 VPS 无法运行它（常见原因：GLIBC 版本过旧）。"
		warn "自动切换为当前 VPS 本机源码编译 otunnel。"
		TUNNELDOCK_FORCE_OTUNNEL_SOURCE=1 install_otunnel
	fi
	otunnel --version >/dev/null 2>&1 || die "otunnel 仍无法运行；停止配置以避免生成不可用的 Tunnel service"
	[[ -n "$tunnel_id" ]] || { read -r -p "OpenAI Tunnel ID: " tunnel_id; }
	[[ "$tunnel_id" =~ ^tunnel_[[:alnum:]_-]+$ ]] || die "Tunnel ID 必须以 tunnel_ 开头，且只包含字母、数字、下划线或连字符"

	if [[ -n "$api_key" ]]; then
		mkdir -p "$(dirname "$api_key_file")"
		umask 077
		printf '%s\n' "$api_key" > "$api_key_file"
	elif [[ ! -s "$api_key_file" ]]; then
		read -r -s -p "OpenAI Restricted API Key: " api_key
		printf '\n'
		[[ -n "$api_key" ]] || die "API Key 不能为空"
		mkdir -p "$(dirname "$api_key_file")"
		umask 077
		printf '%s\n' "$api_key" > "$api_key_file"
	fi
	chmod 600 "$api_key_file"

	log "生成 otunnel profile chappie..."
	otunnel init \
		--profile chappie \
		--profile-dir "$PROFILE_DIR" \
		--tunnel-id "$tunnel_id" \
		--control-plane-base-url "https://api.openai.com" \
		--control-plane-api-key-ref "file:$api_key_file" \
		--mcp-command "chappie" \
		--health-listen-addr "$health_addr" \
		--force

	migrate_chappie
	install_service
	systemctl --user restart chappie-tunnel.service
	sleep 1
	systemctl --user is-active --quiet chappie-tunnel.service || {
		systemctl --user status chappie-tunnel.service --no-pager || true
		die "chappie-tunnel.service 启动失败"
	}
	log "Tunnel 已启动。运行 'tunneldock doctor' 做完整验证。"
}

configure_sessions() {
	local cwd="" prefix="" idle=""
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--cwd) require_value "$@"; cwd="$2"; shift 2 ;;
			--name-prefix) require_value "$@"; prefix="$2"; shift 2 ;;
			--idle-minutes) require_value "$@"; idle="$2"; shift 2 ;;
			-h|--help) echo "Usage: tunneldock sessions-config [--cwd PATH] [--name-prefix NAME] [--idle-minutes 0..1440]"; return ;;
			*) die "未知 sessions-config 参数: $1" ;;
		esac
	done
	write_session_config "$cwd" "$prefix" "$idle"
	if systemctl --user is-active --quiet chappie-tunnel.service 2>/dev/null; then
		systemctl --user restart chappie-tunnel.service
	fi
}

service_action() {
	require_systemd_user
	local action="$1"
	systemctl --user "$action" chappie-tunnel.service
}

status_cmd() {
	require_systemd_user
	systemctl --user status chappie-tunnel.service --no-pager || true
	printf '\nVersions:\n'
	printf '  Node:     %s\n' "$(node --version 2>/dev/null || echo missing)"
	printf '  npm:      %s\n' "$(npm --version 2>/dev/null || echo missing)"
	printf '  Pi:       %s\n' "$(pi --version 2>/dev/null || echo missing)"
	printf '  Chappie:  %s\n' "$(chappie --version 2>/dev/null || echo missing)"
	printf '  otunnel:  %s\n' "$(otunnel --version 2>/dev/null || echo missing)"
	printf '\nChappie config:\n'
	[[ -f "$CHAPPIE_CONFIG" ]] && echo "  present: $CHAPPIE_CONFIG" || echo "  missing: $CHAPPIE_CONFIG"
}

doctor_cmd() {
	local failed=0 pending=0 health_url=""
	check() {
		local label="$1"; shift
		if "$@" >/dev/null 2>&1; then printf 'PASS  %s\n' "$label";
		else printf 'FAIL  %s\n' "$label"; failed=1; fi
	}
	check "node >= 26" node -e 'if (Number(process.versions.node.split(".")[0]) < 26) process.exit(1)'
	check "npm available" command -v npm
	check "pi runnable" pi --version
	check "otunnel runnable" otunnel --version
	check "Chappie broker runnable" chappie --version
	check "Pi Chappie extension registered" pi_chappie_registered
	check "Managed runtime build" node --input-type=commonjs -e 'const p = require(process.argv[1]); if (p.version !== process.argv[2] || ["chatScopedSessions", "runtimeHandshake", "runtimeDiagnostics", "ipcCapacity"].some(k => p.tunneldock?.[k] !== 1)) process.exit(1)' "$CHAPPIE_DIR/package.json" "$CHAPPIE_BUILD_VERSION"
	check "Python YAML support" python3 -c 'import yaml'
	check "Chappie autoCreate config" config_tool validate-sessions "$CHAPPIE_CONFIG"
	check "systemd user bus" systemctl --user show-environment
	if [[ ! -f "$PROFILE_FILE" ]]; then
		printf 'PENDING  otunnel profile is not configured yet\n'
		pending=1
	elif health_url="$(config_tool profile-info "$PROFILE_FILE")"; then
		printf 'PASS  profile and referenced API key metadata\n'
	else
		printf 'FAIL  profile or referenced API key metadata\n'
		failed=1
	fi
	if [[ "$pending" -eq 1 ]]; then
		printf '\nNext step: configure-chappie-tunnel\n'
		[[ "$failed" -eq 0 ]] && return 2
		return 1
	fi
	check "systemd service active" systemctl --user is-active --quiet chappie-tunnel.service
	if have loginctl && [[ "$(loginctl show-user "$(id -un)" -p Linger --value 2>/dev/null || true)" != yes ]]; then
		printf 'WARN  systemd user linger disabled (SSH 注销后服务可能停止)\n'
	fi
	if systemctl --user is-active --quiet chappie-tunnel.service 2>/dev/null; then
		if ! chappie diagnostics --check; then failed=1; fi
		if [[ -z "$health_url" ]] || ! otunnel health --url "$health_url" --require-control-plane-poll; then failed=1; fi
	else
		# Upstream doctor may launch the broker: only invoke it on a valid profile.
		if [[ -n "$health_url" ]] && ! otunnel doctor --profile chappie --profile-dir "$PROFILE_DIR" --explain; then failed=1; fi
	fi
	return "$failed"
}

diagnostics_cmd() {
	if chappie diagnostics "$@"; then return; fi
	if [[ $# -eq 0 && -f "$KEY_DIR/runtime.json" ]]; then
		config_tool runtime-snapshot "$KEY_DIR/runtime.json"
	fi
	# A historical snapshot cannot establish current broker/Pi health.
	return 1
}

logs_cmd() {
	[[ $# -le 1 ]] || die "logs 只接受一个行数或 -f 参数"
	require_systemd_user
	if [[ "${1:-}" == "-f" || "${1:-}" == "--follow" ]]; then
		journalctl --user -u chappie-tunnel.service -f
	else
		[[ "${1:-100}" =~ ^[0-9]+$ ]] || die "日志行数必须为非负整数"
		journalctl --user -u chappie-tunnel.service -n "${1:-100}" --no-pager
	fi
}

sessions_cmd() {
	local state="$KEY_DIR/state.json"
	[[ -f "$state" ]] || state="$PI_AGENT_DIR/chappie.state.json"
	[[ -f "$state" ]] || { echo "No Chappie state yet"; return; }
	config_tool sessions "$state"
}

update_cmd() {
	git -C "$ROOT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "当前安装不是 Git checkout，无法自动 update。"
	[[ -z "$(git -C "$ROOT_DIR" status --porcelain)" ]] || die "checkout 有未提交改动；请先保存改动再 update。"
	log "更新 TunnelDock CLI..."
	git -C "$ROOT_DIR" pull --ff-only
	# Re-exec so the new release's pins and installer are used in this update.
	exec "$ROOT_DIR/bin/tunneldock" install
}

usage() {
	cat <<EOF
TunnelDock CLI v$VERSION

Usage:
  tunneldock install
  tunneldock configure [--tunnel-id ID] [--api-key-file PATH] [--health-addr ADDR]
  tunneldock sessions-config [--cwd PATH] [--name-prefix NAME] [--idle-minutes N]
  tunneldock start|stop|restart
  tunneldock status
  tunneldock doctor
  tunneldock diagnostics [--json]
  tunneldock logs [N|-f]
  tunneldock sessions
  tunneldock update
  tunneldock version

Environment overrides:
  TUNNELDOCK_NODE_VERSION=$NODE_VERSION
  TUNNELDOCK_PI_VERSION=$PI_VERSION
  TUNNELDOCK_CHAPPIE_VERSION=$CHAPPIE_VERSION
  TUNNELDOCK_OTUNNEL_VERSION=$OTUNNEL_VERSION
  TUNNELDOCK_FORCE_OTUNNEL_SOURCE=1   # skip release binary; compile on this VPS
EOF
}

main() {
	local cmd="${1:-help}"
	shift || true
	case "$cmd" in
		install|start|stop|restart|status|doctor|sessions|update|version|-v|--version)
			if [[ $# -eq 1 && ( "$1" == --help || "$1" == -h ) ]]; then usage; return; fi
			[[ $# -eq 0 ]] || die "$cmd 不接受额外参数"
			;;
		diagnostics)
			if [[ $# -eq 1 && ( "$1" == --help || "$1" == -h ) ]]; then usage; return; fi
			[[ $# -eq 0 || ( $# -eq 1 && "$1" == --json ) ]] || die "diagnostics 仅接受 --json"
			;;
	esac
	case "$cmd" in
		install) install_all "$@" ;;
		configure) configure_tunnel "$@" ;;
		sessions-config) configure_sessions "$@" ;;
		start) service_action start ;;
		stop) service_action stop ;;
		restart) service_action restart ;;
		status) status_cmd ;;
		doctor) doctor_cmd ;;
		diagnostics) diagnostics_cmd "$@" ;;
		logs) logs_cmd "$@" ;;
		sessions) sessions_cmd ;;
		update) update_cmd ;;
		version|-v|--version) echo "tunneldock $VERSION" ;;
		help|-h|--help) usage ;;
		*) usage; die "未知命令: $cmd" ;;
	esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
	main "$@"
fi
