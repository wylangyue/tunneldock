+					"cwd_unavailable",
+					"pi_not_found",
+					"permission_denied",
+					"spawn_failed",
+					"process_stopped",
+					"unexpected_exit",
+					"broker_stopped",
+					"startup_timeout",
+					"startup_failed",
+				]),
+				updatedAt: z.iso.datetime(),
+				activity: z
+					.enum(["idle", "ready", "executing", "generating"])
+					.optional(),
+				pid: z.number().int().positive().optional(),
+				piVersion: version.optional(),
+				nodeVersion: version.optional(),
+				toolCount: z.number().int().min(0).max(128).optional(),
+				exitCode: z.number().int().optional(),
+				signal: z
+					.string()
+					.regex(/^SIG[A-Z0-9]{1,16}$/)
+					.optional(),
+				stderrCode: z
+					.enum([
+						"no_diagnostic",
+						"module_not_found",
+						"syntax_error",
+						"permission_denied",
+						"extension_load_failed",
+						"provider_unavailable",
+					])
+					.optional(),
+				stderrTruncated: z.boolean().optional(),
+			}),
+		)
+		.max(256),
+});
+
+export async function queryDiagnostics(directory = getDirectory()) {
+	const socket = createConnection(ipcEndpoint(directory));
+	let peer: JsonLinePeer<BrokerMessage, SessionMessage> | undefined;
+	try {
+		const value = await new Promise<unknown>((resolve, reject) => {
+			const timer = setTimeout(() => reject(new Error("timeout")), 5_000);
+			socket.once("error", () => reject(new Error("unavailable")));
+			socket.once("close", () => {
+				clearTimeout(timer);
+				reject(new Error("closed"));
+			});
+			socket.once("connect", () => {
+				peer = new JsonLinePeer(
+					socket,
+					(message) => {
+						if (message.type !== "diagnostics" || message.id !== 1) return;
+						clearTimeout(timer);
+						resolve(message.diagnostics);
+					},
+					() => reject(new Error("closed")),
+				);
+				void peer
+					.send({ type: "diagnostics", id: 1 })
+					.catch(() => reject(new Error("send_failed")));
+			});
+		});
+		return snapshotSchema.parse(value);
+	} catch {
+		throw new Error(
+			"Broker runtime diagnostics unavailable; check service, socket and build version",
+		);
+	} finally {
+		peer?.close();
+		socket.destroy();
+	}
+}
+
+export async function showDiagnostics(
+	json = false,
+	check = false,
+): Promise<void> {
+	const snapshot = await queryDiagnostics();
+	if (json) console.log(JSON.stringify(snapshot));
+	else {
+		console.log(
+			`PASS  broker IPC reachable (pid=${snapshot.pid}, build=${snapshot.extensionBuild})`,
+		);
+		const online = snapshot.sessions.filter(
+			(session) => session.status === "online",
+		);
+		if (online.length)
+			console.log(
+				`PASS  ${online.length} managed Pi runtime handshake(s) verified`,
+			);
+		else
+			console.log(
+				"WARN  no managed Pi currently online; a live Pi handshake has not been checked by this command",
+			);
+		for (const session of snapshot.sessions)
+			console.log(
+				`${session.sessionId} ${session.status}${session.activity ? `/${session.activity}` : ""} ${session.code} pi=${session.piVersion ?? "unknown"} stderr=${session.stderrCode ?? "no_diagnostic"}`,
+			);
+	}
+	if (
+		check &&
+		snapshot.sessions.some(
+			(session) => session.status === "failed" || session.status === "starting",
+		)
+	)
+		process.exitCode = 1;
+}
