--- /dev/null
+++ b/src/runtime.ts
@@ -0,0 +1,112 @@
+import { timingSafeEqual } from "node:crypto";
+import packageJson from "../package.json" with { type: "json" };
+import type { SessionDescription } from "./ipc.ts";
+
+export const runtimeRevision = 1;
+export const extensionBuild = packageJson.version;
+export const runtimeCapabilities = [
+	"inspect",
+	"history",
+	"call",
+	"cancel",
+	"settled",
+];
+export const ipcLimits = {
+	frameBytes: 16 * 1024 * 1024,
+	writeBytes: 32 * 1024 * 1024,
+	readBytes: 32 * 1024 * 1024,
+	handlers: 64,
+	peers: 64,
+	pendingPerPeer: 64,
+	pendingTotal: 256,
+	sessionQueue: 64,
+	sessionQueueBytes: 16 * 1024 * 1024,
+};
+
+export interface RuntimeHandshake {
+	revision: number;
+	nonce: string;
+	extensionBuild: string;
+	piVersion: string;
+	nodeVersion: string;
+	capabilities: string[];
+	tools: string[];
+}
+
+export function validManagedRuntime(
+	session: SessionDescription,
+	expected: { nonce: string; cwd: string },
+): boolean {
+	const runtime = session.runtime;
+	if (
+		!runtime ||
+		typeof runtime.nonce !== "string" ||
+		!/^[-a-f0-9]{36}$/.test(runtime.nonce) ||
+		runtime.nonce.length !== expected.nonce.length ||
+		!timingSafeEqual(Buffer.from(runtime.nonce), Buffer.from(expected.nonce))
+	)
+		return false;
+	return (
+		session.agent === "pi" &&
+		session.cwd === expected.cwd &&
+		session.model === "chappie/chatgpt" &&
+		["idle", "ready", "executing", "generating"].includes(session.status) &&
+		runtime.revision === runtimeRevision &&
+		runtime.extensionBuild === extensionBuild &&
+		typeof runtime.piVersion === "string" &&
+		runtime.piVersion.length <= 64 &&
+		/^\d+\.\d+\.\d+(?:[-+][\w.-]+)?$/.test(runtime.piVersion) &&
+		typeof runtime.nodeVersion === "string" &&
+		runtime.nodeVersion.length <= 32 &&
+		/^\d+\.\d+\.\d+$/.test(runtime.nodeVersion) &&
+		Number(runtime.nodeVersion.split(".")[0]) >= 26 &&
+		Array.isArray(runtime.capabilities) &&
+		runtime.capabilities.length === runtimeCapabilities.length &&
+		runtimeCapabilities.every((value) =>
+			runtime.capabilities.includes(value),
+		) &&
+		Array.isArray(runtime.tools) &&
+		runtime.tools.length <= 128 &&
+		runtime.tools.every(
+			(value) => typeof value === "string" && /^[\w.-]{1,128}$/.test(value),
+		) &&
+		new Set(runtime.tools).size === runtime.tools.length &&
+		runtime.tools.includes("read")
+	);
+}
+
+// Inspect at most 64 KiB. Arbitrary stderr is never returned or persisted: even
+// unknown credential formats cannot escape via a parser error or stack trace.
+export class StartupDiagnostics {
+	#bytes = 0;
+	#tail = "";
+	code = "no_diagnostic";
+	truncated = false;
+
+	append(chunk: Buffer): void {
+		const available = Math.max(0, 64 * 1024 - this.#bytes);
+		this.truncated ||= chunk.length > available;
+		if (!available) return;
+		const text = this.#tail + chunk.subarray(0, available).toString("utf8");
+		this.#bytes += Math.min(chunk.length, available);
+		for (const [pattern, code] of [
+			[
+				/MODULE_NOT_FOUND|ERR_MODULE_NOT_FOUND|Cannot find (?:module|package)/i,
+				"module_not_found",
+			],
+			[/SyntaxError|Unexpected token/i, "syntax_error"],
+			[/EACCES|Permission denied/i, "permission_denied"],
+			[
+				/extension.{0,40}(?:fail|error)|(?:fail|error).{0,40}extension/i,
+				"extension_load_failed",
+			],
+			[/unknown provider|provider.{0,40}not found/i, "provider_unavailable"],
+		] as const) {
+			if (pattern.test(text)) {
+				this.code = code;
+				break;
+			}
+		}
+		this.#tail = text.slice(-128);
+	}
+}
